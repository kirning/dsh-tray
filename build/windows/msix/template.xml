<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="dsh-tray-wails.exe"
        Arguments=""
        InstallLocation="C:\Program Files\My Company\dsh tray">
    </Installer>
    <PackageInformation
        PackageName="dsh tray"
        PackageDisplayName="dsh tray"
        PublisherName="CN=My Company"
        PublisherDisplayName="My Company"
        Version="2.0.0.0"
        PackageDescription="dsh web tray manager">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.example.dshtraywails"
                Description="dsh web tray manager"
                DisplayName="dsh tray"
                ExecutableName="dsh-tray-wails.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>dsh tray</DisplayName>
            <PublisherDisplayName>My Company</PublisherDisplayName>
            <Description>dsh web tray manager</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="dsh-tray-wails.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
